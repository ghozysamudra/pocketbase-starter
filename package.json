		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.1",
		"clsx": "^2.1.1",
		"playwright": "^1.64.1",
		"shadcn-svelte": "^1.7.0",
